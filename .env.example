# cp .env.example .env   (docker compose reads it; start.sh users can `export` the same names). Never commit .env.
# Everything is OPTIONAL: Rex works fully offline without any of these.

# ---- data modes
REX_OFFLINE=1                 # 1 = bundled price cache for the engine/tracker (default). 0 = live yfinance (NSE) and Binance (crypto)
# REX_CRYPTO_OFFLINE=0        # 1 = never call Binance/yfinance for crypto
# REX_PIPELINE_OFFLINE=0      # pipeline service: 1 = only seed the store from the bundled cache, no network. Default: live
# REX_STORE=backend/data_store            # Parquet store + catalog.sqlite (compose: /data/store volume)
# REX_DB=backend/rexlite_memory.sqlite    # SQLite memory (compose: /data/sqlite volume)
# REX_DATA_CACHE=backend/data_cache       # CSV price cache fallback
# REX_PIPELINE_RETRIES=3                  # provider retries per symbol (exponential backoff)
# REX_PIPELINE_BACKOFF_S=1.5              # first backoff, doubles each retry
# REX_TRACK_INTERVAL=60                   # Live Strategy Tracker refresh seconds (Yahoo NSE prices are ~15 min delayed)
# REX_NEWS_OFFLINE=0                      # 1 = no news / CoinGecko calls (tests use this)
# REX_TRACKER_LOOP=1                      # 0 = disable the tracker's background loop

# ---- optional keys (never required)
# MEKO_TOKEN=                 # enables the Meko MCP memory mirror (https://mcp.mekodata.ai/mcp)
# MEKO_DATAPACK_ID=           # optional Meko datapack to write into
# GEMINI_API_KEY=             # better plain-English strategy parsing on Build + the Explain button
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_API_KEY=               # optional: Explain button (Next server side)

# ---- database
# REX_DB_URL=postgresql://yugabyte@yugabyte:5433/rexlite   # Compose network URL; direct host startup uses postgresql://yugabyte@127.0.0.1:5434/rexlite. Unset/unreachable -> SQLite fallback.
# REX_DB_IMPORT=1             # first start on an empty Yugabyte: copy the shipped demo memory in from the SQLite file (0 = skip)

# ---- web
# NEXT_PUBLIC_API=http://localhost:8000   # URL the BROWSER uses to reach the API (baked in at web build time)
